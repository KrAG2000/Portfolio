{
  "name": "kartik-portfolio-quality",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/validate-content.mjs",
    "dependencies:check": "npm ls --depth=0",
    "check": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run content:check && npm run dependencies:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  }
}
