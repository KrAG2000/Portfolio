  "html": "<a class=\"skip-link\" href=\"#archive\">Skip to archive</a>\n\n    <header class=\"site-header wrap\">\n      <a class=\"monogram\" href=\"./\" aria-label=\"Kartik Agnihotri, home\">KA<span>.</span></a>\n      <div class=\"header-note\" aria-label=\"Archive status\">\n        <span class=\"pulse\" aria-hidden=\"true\"></span>\n        Portfolio archive\n      </div>\n      <a class=\"quiet-link\" href=\"#resume\" data-resume-link target=\"_blank\" rel=\"noreferrer\">Résumé <span>↗</span></a>\n      <a class=\"quiet-link quiet-link-left\" href=\"mailto:agni5kartik@gmail.com\">Say hello <span>↗</span></a>\n    </header>\n\n    <main>\n      <section class=\"hero wrap\" aria-labelledby=\"page-title\">\n        <div class=\"hero-index\" aria-hidden=\"true\">00 / INDEX</div>\n        <div class=\"hero-copy\">\n          <p class=\"eyebrow\">Kartik Agnihotri · Software Engineer</p>\n          <h1 id=\"page-title\">Work changes.<br /><em>This is the record.</em></h1>\n          <p class=\"lede\">\n            A versioned collection of the systems Ive built, the problems I’ve followed,\n            and the engineer I was becoming at each turn.\n          </p>\n        </div>\n        <div class=\"orbit\" aria-hidden=\"true\">\n          <div class=\"orbit-ring\"></div>\n          <div class=\"orbit-core\">KA</div>\n          <span class=\"orbit-dot\"></span>\n          <span class=\"orbit-label\">BUILD / LEARN / REPEAT</span>\n        </div>\n      </section>\n\n      <section class=\"archive wrap\" id=\"archive\" aria-labelledby=\"archive-title\">\n        <div class=\"section-heading\">\n          <div>\n            <p class=\"eyebrow\">The archive</p>\n            <h2 id=\"archive-title\">Choose a chapter.</h2>\n          </div>\n          <p class=\"archive-count\"><span id=\"version-count\">01</span> published</p>\n        </div>\n\n        <div class=\"version-list\" id=\"version-list\" aria-live=\"polite\">\n          <noscript>\n            <a class=\"version-card\" href=\"chapter.html?id=v1\">\n              <span>Chapter 01 · Fragmatic</span>\n              <strong>Systems that work<br />when nobody is watching.</strong>\n            </a>\n          </noscript>\n        </div>\n      </section>\n\n      <section class=\"archive-note wrap\" aria-labelledby=\"archive-note-title\">\n        <p class=\"eyebrow\">Why versions?</p>\n        <h2 id=\"archive-note-title\">A résumé is a snapshot.<br />A career is a sequence.</h2>\n        <p>\n          Each chapter pairs the facts with the texture around them: working principles,\n          side explorations and a small interactive idea from that period.\n        </p>\n      </section>\n    </main>\n\n    <footer class=\"site-footer wrap\">\n      <p>Engineering systems, one layer deeper.</p>\n      <p>© <span id=\"year\"></span> Kartik Agnihotri</p>\n    </footer>",
